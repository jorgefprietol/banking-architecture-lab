  "components": {
    "schemas": {
      "CreateAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerId",
          "openingMinor",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1
          },
          "openingMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          }
        }
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerId",
          "balanceMinor",
          "currency",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string"
          },
          "balanceMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Transfer": {
        "type": "object",
