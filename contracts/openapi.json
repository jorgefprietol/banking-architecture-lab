        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationId": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          }
        }
      },
      "AccountEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "version",
          "delta",
          "currency"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "delta": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          }
        }
      },
      "RiskSignal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amountMinor",
          "recentTransfers",
          "sanctionsMatch"
        ],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000
          },
          "recentTransfers": {
            "type": "integer",
            "minimum": 0
          },
          "sanctionsMatch": {
            "type": "boolean"
          }
        }
      },
      "RiskFinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
