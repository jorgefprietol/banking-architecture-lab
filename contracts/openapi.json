          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "blocked": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SettlementRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "minor"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "minor": {
            "type": "integer"
          }
        }
      },
      "Reconciliation": {
        "type": "object",
