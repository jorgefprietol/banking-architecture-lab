        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "ProductRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "available",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Reservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationId",
          "quantity",
          "expectedVersion"
        ],
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Onboarding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicantReference",
          "currency"
        ],
        "properties": {
          "applicantReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          }
        }
      },
      "OnboardingResult": {
        "type": "object",
